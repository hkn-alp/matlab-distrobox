#!/usr/bin/env bash
set -euo pipefail

CONTAINER_NAME="astro"
IMAGE="docker.io/library/ubuntu:24.04"

# Base Paths (aligned with isolated Btrfs subvolume)
CONTAINER_STORAGE="$HOME/.local/share/containers"
CONTAINER_HOME="$CONTAINER_STORAGE/distrobox-homes/$CONTAINER_NAME"
APPS_DIR="$CONTAINER_STORAGE/apps"
MATLAB_DIR="$APPS_DIR/matlab"
MATLAB_RELEASE="R2026a"

echo "📁 Ensuring required host and theme directories exist..."
mkdir -p \
    "$CONTAINER_HOME/.config/gtk-3.0" \
    "$CONTAINER_HOME/.config/gtk-4.0" \
    "$APPS_DIR" \
    "$MATLAB_DIR" \
    "$HOME/.local/share/applications"

# Pre-seed Dark Theme in isolated container home to prevent GTK/CEF white flash
cat << 'GTK_EOF' > "$CONTAINER_HOME/.config/gtk-3.0/settings.ini"
[Settings]
gtk-application-prefer-dark-theme=1
gtk-theme-name=Adwaita-dark
gtk-icon-theme-name=Adwaita
GTK_EOF
cp "$CONTAINER_HOME/.config/gtk-3.0/settings.ini" "$CONTAINER_HOME/.config/gtk-4.0/settings.ini"

# 1. Create Distrobox Container (exact name match)
if ! distrobox list | awk -F'|' 'NR>1 {gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2}' | grep -Fxq "$CONTAINER_NAME"; then
    echo "🚀 Creating Distrobox container: ${CONTAINER_NAME}..."
    distrobox create \
        --name "$CONTAINER_NAME" \
        --image "$IMAGE" \
        --nvidia \
        --home "$CONTAINER_HOME" \
        --volume "$APPS_DIR:/opt/apps:rw" \
        -Y
else
    echo "ℹ️ Container ${CONTAINER_NAME} already exists. Skipping creation."
fi

# 2. Install System Dependencies & MPM
# Note: Ubuntu 24.04 ships with Python 3.12 natively; deadsnakes PPA is not needed.
echo "📦 Installing Ubuntu 24.04 dependencies and mpm..."
distrobox enter "$CONTAINER_NAME" -- bash -c '
    set -euo pipefail
    sudo apt-get update && sudo apt-get install -y \
        curl ca-certificates software-properties-common \
        libatomic1 libgl1 libglu1-mesa libgbm1 libdrm2 \
        libxi6 libxrender1 libxtst6 libxrandr2 libxcomposite1 libxdamage1 libxkbcommon0 \
        libgstreamer1.0-0 gstreamer1.0-plugins-base libgomp1 \
        openjdk-11-jre libpcre2-32-0 \
        adwaita-icon-theme gnome-themes-extra gsfonts wmctrl \
        libgtk-3-0t64 libcanberra-gtk3-module \
        dbus-x11 libasound2t64 libnspr4 libnss3 \
        python3 python3-dev python3-venv

    if [ ! -f /usr/local/bin/mpm ]; then
        echo "⬇️ Downloading MATLAB Package Manager (mpm)..."
        sudo curl -fsSL https://www.mathworks.com/mpm/glnxa64/mpm -o /usr/local/bin/mpm
        sudo chmod +x /usr/local/bin/mpm
    fi
'

# 3. Automatic Repository MPM Installation
echo ""
read -rp "Do you want to run mpm install now? [y/N]: " RUN_MPM
if [[ "$RUN_MPM" =~ ^[Yy]$ ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    DEFAULT_INPUT_FILE="$SCRIPT_DIR/mpm-input-r2026a.txt"

    if [ -f "$DEFAULT_INPUT_FILE" ]; then
        echo "⏳ Installing MATLAB via mpm using repository configuration..."
        cp "$DEFAULT_INPUT_FILE" "$CONTAINER_HOME/mpm_input.txt"

        distrobox enter "$CONTAINER_NAME" -- bash -c "
            mpm install --inputfile ~/mpm_input.txt
        "
    else
        echo "⚠️ File not found at '$DEFAULT_INPUT_FILE'. Skipping installation step."
    fi
fi

# 4. Create Modern Host Wrapper / Launcher
echo "⚙️ Creating host launcher wrapper in ${MATLAB_DIR}/matlab-launcher..."
cat << 'MATLAB_LAUNCH_EOF' > "$MATLAB_DIR/matlab-launcher"
#!/usr/bin/env bash
FILE_PATH="${1:-}"

# Native Wayland & Dark Theme flags to eliminate initial white flash in GTK/Chromium UI
export GDK_BACKEND=wayland,x11
export QT_QPA_PLATFORM="wayland;xcb"
export GTK_THEME=Adwaita:dark
export QT_STYLE_OVERRIDE=Adwaita-Dark

# Force embedded Chromium (JCEF/CEF) to initialize with a dark canvas immediately
export MATLAB_CEF_ARGS="--force-dark-mode --enable-features=WebUIDarkMode"

if [ -n "$FILE_PATH" ]; then
    ABS_PATH=$(realpath "$FILE_PATH")

    if [ -d "$ABS_PATH" ]; then
        # Target is a directory: just start MATLAB in that directory
        exec distrobox enter astro -- /opt/apps/matlab/R2026a/bin/matlab -desktop -nosplash -sd "$ABS_PATH"
    else
        # Target is a file: extract parent directory, start there, and open the file
        DIR_PATH=$(dirname "$ABS_PATH")
        ESCAPED_FILE="${ABS_PATH//\'/\'\'}"
        ESCAPED_DIR="${DIR_PATH//\'/\'\'}"

        # Combine cd() inside -r with -sd as a fallback so Startup settings don't override it
        CMD="try cd('$ESCAPED_DIR'); uiopen('$ESCAPED_FILE', true); catch ME; disp(ME.message); end"

        exec distrobox enter astro -- /opt/apps/matlab/R2026a/bin/matlab -desktop -nosplash -sd "$DIR_PATH" -r "$CMD"
    fi
else
    exec distrobox enter astro -- /opt/apps/matlab/R2026a/bin/matlab -desktop -nosplash
fi
MATLAB_LAUNCH_EOF

chmod +x "$MATLAB_DIR/matlab-launcher"

# 5. Create Desktop Entry on the Host
echo "🖥️ Generating host .desktop entry..."
cat << MATLAB_DESKTOP_EOF > "$HOME/.local/share/applications/astro-matlab.desktop"
[Desktop Entry]
Version=1.0
Type=Application
Name=MATLAB (Astro)
Comment=MATLAB Technical Computing Environment
Exec=$MATLAB_DIR/matlab-launcher %F
Icon=$MATLAB_DIR/R2026a/ui/icons/16x16/matlabLogo.svg
StartupWMClass=MATLAB R2026a
Terminal=false
Categories=Science;Education;Development;
Categories=Science;Education;Development;
MimeType=text/x-matlab;application/matlab;application/x-matlab-data;application/vnd.mathworks.simulink.model;
MATLAB_DESKTOP_EOF

# 6. Update Caches
echo "🔄 Updating desktop and MIME caches..."
update-desktop-database "$HOME/.local/share/applications/" 2>/dev/null || true
if [ -d "$HOME/.local/share/icons" ]; then
    gtk-update-icon-cache -f -t "$HOME/.local/share/icons/" 2>/dev/null || true
fi

echo "✅ Environment configured! Launch MATLAB via your desktop launcher or '$MATLAB_DIR/matlab-launcher'."
